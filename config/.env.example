# Copy to config/.env or project-root .env. Never commit the real file.
# Create a dedicated Bybit API key with NO Withdraw permission. Bind an IP whitelist.

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# backtest | paper | testnet | mainnet
MODE=paper

# Required to send real orders on mainnet. Reading account data does not need this flag.
LIVE_TRADING_CONFIRM=false

# Optional. Never log these values.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_USER_IDS=
