// Volume Wrangle — large SDF displacement + domain warp.
// Do this in VDB space (Gatis Kurzemnieks / RenderEverything): do not
// displace mesh points. Keep amplitude under voxel_size * exterior_band.

float fbm(vector p; int octaves; float roughness)
{
    float amp = 1.0;
    float sum = 0.0;
    float norm = 0.0;
    vector q = p;
    int n = max(octaves, 1);
    for (int i = 0; i < n; i++)
    {
        sum += amp * (noise(q) * 2.0 - 1.0);
        norm += amp;
        amp *= roughness;
        q *= 2.03;
    }
    return sum / max(norm, 1e-6);
}

float worley_f2f1(vector p)
{
    float f1, f2;
    wnoise(p, f1, f2);
    return f2 - f1;
}

float warp_amp   = chf("warp_amp");      // 0.35
float warp_freq  = chf("warp_freq");     // 0.55
float fbm_amp    = chf("fbm_amp");       // 0.22
float fbm_freq   = chf("fbm_freq");      // 0.85
int   fbm_oct    = chi("fbm_octaves");   // 5
float fbm_rough  = chf("fbm_rough");     // 0.48
float cell_amp   = chf("cell_amp");      // 0.16
float cell_freq  = chf("cell_freq");     // 1.15
float cell_stretch = chf("cell_stretch"); // 0.28  <1 stretches cells vertically
int   seed       = chi("seed");

vector p = v@P;
p += set(seed * 0.17, seed * 0.31, seed * 0.11);

// Domain warp: break the regular noise lattice (Entagma / cliff VDB videos).
vector warp = set(
    fbm(p * warp_freq + set(3.1, 0, 0), 3, 0.5),
    fbm(p * warp_freq + set(0, 7.7, 0), 3, 0.5),
    fbm(p * warp_freq + set(0, 0, 2.4), 3, 0.5)
) * warp_amp;

vector q = p + warp;

float macro = fbm(q * fbm_freq, fbm_oct, fbm_rough) * fbm_amp;

// Vertically stretched Worley F2-F1 = jointed blocks (80.lv rock breakdown).
vector cw = set(q.x, q.y * cell_stretch, q.z) * cell_freq;
float cells = (worley_f2f1(cw) * 2.0 - 0.7) * cell_amp;

f@surface += macro + cells;
